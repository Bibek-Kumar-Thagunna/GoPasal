{
  "expo": {
    "name": "GoPasal Delivery",
    "slug": "gopasal-delivery",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "gopasal-delivery",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": { "backgroundColor": "#1a3a2a", "resizeMode": "contain" },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gopasal.delivery",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GoPasal needs your location to show delivery routes.",
        "NSLocationAlwaysUsageDescription": "GoPasal needs your location while delivering orders."
      }
    },
    "android": {
      "package": "com.gopasal.delivery",
      "adaptiveIcon": { "backgroundColor": "#1a3a2a" },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "ACCESS_BACKGROUND_LOCATION"]
    },
    "web": { "bundler": "metro", "output": "static", "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router", "expo-secure-store", "expo-font", "expo-location", ["expo-splash-screen", { "backgroundColor": "#1a3a2a" }]],
    "experiments": { "typedRoutes": true }
  }
}
