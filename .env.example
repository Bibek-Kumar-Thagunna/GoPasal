# ─── Backend (backend/.env or root when running from repo root) ─────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:pass@localhost:5432/gopasal
JWT_ACCESS_SECRET=change-me-access-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ─── Expo apps (apps/*/ — prefix EXPO_PUBLIC_) ───────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# ─── Optional: seller web smoke (e2e/playwright.seller.config.ts) ────────────
# SELLER_E2E_BASE_URL=http://localhost:8081
