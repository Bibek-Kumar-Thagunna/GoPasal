# ──────────────────────────────────────────────────────────────
# GoPasal Backend — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate secrets with: openssl rand -hex 32
# ──────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development          # development | production | test
PORT=3000

# Database (PostgreSQL 15+ with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gopasal

# Redis (required in production — flash-sale reservations, rate limiting)
REDIS_URL=redis://localhost:6379

# JWT secrets (>= 32 chars; production refuses the bundled defaults)
JWT_SECRET=change-me-jwt-secret-32-chars-minimum
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-minimum
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-minimum

# OTP (short — e.g. customer login)
OTP_EXPIRY_SECONDS=300
# Seller register flow: OTP is checked at onboarding submission (default 30m / 1800s)
SELLER_REGISTRATION_OTP_EXPIRY_SECONDS=1800

# CORS — comma-separated allow-list. Wildcard "*" is FORBIDDEN in production.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Feature flags
ENABLE_ANALYTICS=true

# ── Payments: Khalti ─────────────────────────────────────────
# Sandbox: https://dev.khalti.com/api/v2  (test-admin.khalti.com)
# Live:    https://khalti.com/api/v2      (production must use live URL + secret)
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
# Customer web URL (Khalti return_url must be reachable; use your VPS URL in production)
PUBLIC_WEB_URL=http://localhost:8081
PAYMENT_RETURN_PATH=/payment/return

# ── Payments: eSewa ──────────────────────────────────────────
# Mock for dev ONLY — forbidden in production (server refuses to boot with
# ESEWA_MOCK_ENABLED=true when NODE_ENV=production).
ESEWA_MOCK_ENABLED=true
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
PUBLIC_API_URL=http://localhost:3000

# ── Payments: SkyPay aggregator (optional; primary when enabled) ──
SKYPAY_ENABLED=false
SKYPAY_MOCK_ENABLED=true
SKYPAY_API_KEY=
SKYPAY_API_SECRET=
SKYPAY_MERCHANT_ID=
SKYPAY_BASE_URL=https://api.skypay.example/v1
SKYPAY_WEBHOOK_SECRET=

# ── Google OAuth (admin + customer social login) ─────────────
# Same client ID as admin-web NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# When unset, Google sign-in fails closed (no mock tokens are accepted).
GOOGLE_CLIENT_ID=

# ── SMS — Sparrow SMS (https://sparrowsms.com) ───────────────
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=GoPasal

# ── SMS — UniMatrix (alternative provider) ───────────────────
UNIMTX_ACCESS_KEY_ID=
UNIMTX_ACCESS_KEY_SECRET=

# ── Email — Resend (https://resend.com) ──────────────────────
RESEND_API_KEY=
EMAIL_FROM=GoPasal <noreply@yourdomain.com>

# ── AI / semantic search (OpenAI-compatible embeddings) ──────
# When set, search uses text-embedding-3-small (1536 dims). When unset,
# search falls back to deterministic hashed vectors (dev/test only — the
# fallback is never used in production without a key).
OPENAI_API_KEY=

# ── Optional: object storage for uploaded media ──────────────
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
