{
  "name": "gopasal-backend",
  "version": "1.0.0",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:migrate:kit": "bunx drizzle-kit migrate",
    "db:seed": "bun run src/db/seed.ts",
    "db:studio": "bunx drizzle-kit studio",
    "typecheck": "bunx tsc --noEmit",
    "test:e2e": "bun test src/test/e2e/full-flow.e2e.test.ts",
    "test:contract": "bun test src/test/seller-order.workflow.unit.test.ts",
    "test": "bun run src/test/truncate.ts && bun test src/test/"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.2.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/eden": "^1.4.8",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/stream": "^1.1.0",
    "@elysiajs/swagger": "^1.3.1",
    "@elysiajs/websocket": "^0.2.8",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.1",
    "elysia": "latest",
    "elysia-rate-limit": "^4.5.0",
    "ioredis": "^6.0.0",
    "nanoid": "^5.1.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.8",
    "uni-sdk": "^0.3.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.30.6"
  }
}